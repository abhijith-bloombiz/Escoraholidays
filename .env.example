# ==============================================================================
# Escora Holidays Environment Variables (.env)
# ==============================================================================

# Database Configuration (MongoDB)
# Connection string for MongoDB (Local instance or MongoDB Atlas).
# Local:  mongodb://localhost:27017/escora_dev
# Atlas:  mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/escora?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# API Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000

# Public Portal Maintenance Mode (true = hidden/maintenance, false = public portal active)
MAINTENANCE_MODE=false
VITE_MAINTENANCE_MODE=false

# Session Secret (Cookie encryption)
# In production, must be at least 32 characters long and not a known default.
SESSION_SECRET=escora-dev-secret-change-in-prod

# Admin Authentication
# In production:
# - ADMIN_USER (or ADMIN_USERNAME) must be set (minimum 3 characters)
# - ADMIN_PASSWORD_HASH must be set (scrypt hash: "scrypt$<saltHex:32>$<derivedKeyHex:128>")
# For local development, ADMIN_PASSWORD plaintext is supported as a fallback.
ADMIN_USER=Admin
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_PASSWORD=change-me-in-local-dev

# CORS Allowed Origins
# Comma-separated list of trusted origins for credentialed requests.
# Example: https://admin.escoraholidays.com,https://escoraholidays.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==============================================================================
# Email Delivery Provider Configuration
# ==============================================================================
# Select active email provider: "gmail" | "resend" | "auto" | "mock"
# Default: auto (prioritizes Gmail if GMAIL_APP_PASSWORD is set, else Resend)
EMAIL_PROVIDER=gmail

# Gmail Authenticated SMTP (Genuine Sender: arunopera7@gmail.com)
# Authentication mechanism: Google Account 2-Step Verification + App Password
# Steps to generate:
# 1. Sign in to your Google Account (https://myaccount.google.com).
# 2. Go to Security -> 2-Step Verification (must be enabled).
# 3. Scroll to the bottom and select "App passwords" (or visit https://myaccount.google.com/apppasswords).
# 4. Create a new App Password named "Escora Admin".
# 5. Copy the generated 16-character code into GMAIL_APP_PASSWORD below.
GMAIL_USER=arunopera7@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="Escora Journeys"
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# Alternative Email Service: Resend (Custom Domain Delivery)
# Real sending is disabled by default (CAMPAIGN_SENDING_ENABLED=false).
# When disabled or when RESEND_API_KEY is not set, campaign dispatch operates in safe simulation mode.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Escora Journeys <admin@escoraholidays.com>"
ADMIN_EMAIL=admin@escoraholidays.com
CAMPAIGN_SENDING_ENABLED=false
# Webhook signing secret from Resend dashboard (Svix) for delivery tracking
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Background scheduler poll interval in milliseconds (default: 20000 = 20s)
CAMPAIGN_SCHEDULER_INTERVAL_MS=20000

# Transactional Email Automations
# Real sending for transactional messages is disabled by default in development unless explicitly enabled.
TRANSACTIONAL_SENDING_ENABLED=false
# Configurable delays for scheduled automations
ENQUIRY_FOLLOWUP_DELAY_HOURS=24
POST_TRIP_FEEDBACK_DELAY_HOURS=24
# Optional custom feedback / Google review URL (defaults to ${PUBLIC_URL}/contact)
FEEDBACK_REVIEW_URL=https://www.escoraholidays.com/contact
# Feature flags to enable or disable specific automation triggers
ENABLE_BOOKING_CONFIRMATION=true
ENABLE_ITINERARY_UPDATE_NOTIFICATIONS=true
ENABLE_ENQUIRY_FOLLOWUP=true
ENABLE_POST_TRIP_FEEDBACK=true
ENABLE_PAYMENT_RECEIPTS=true
ENABLE_PAYMENT_REMINDERS=true
ENABLE_PRE_TRIP_REMINDERS=true
ENABLE_CANCELLATION_NOTIFICATIONS=true
ENABLE_DOCUMENT_DELIVERY=true

# Prerendering (Optional)
# CHROMIUM_PATH=

# AI Service Configuration (Groq)
# Backend-only. Never expose to client applications or the browser.
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Configurable model ID (defaults to llama-3.3-70b-versatile, or llama-3.1-8b-instant for fast responses)
GROQ_MODEL=llama-3.3-70b-versatile
# Optional custom base URL for OpenAI-compatible proxies (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Dynamic Travel Photography Search (Method B)
# Automatically matches exact high-resolution photographs to AI-planned days and activities.
# If keys are omitted, the server automatically uses Wikimedia Commons open knowledge search and Escora's curated catalog.
# Unsplash (50 free searches/hr): https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Pexels (20,000 free searches/month): https://www.pexels.com/api
# PEXELS_API_KEY=your_pexels_api_key_here

# ==============================================================================
# WhatsApp Automation Configuration
# ==============================================================================
# In Stage 1 (Mock Foundation), live sending is disabled by default.
# The mock provider simulates sending and records full delivery states without calling Meta.
# WHATSAPP_PROVIDER: "mock" (default) or "cloud_api" (future stage)
WHATSAPP_PROVIDER=mock
WHATSAPP_LIVE_SENDING_ENABLED=false

# Meta WhatsApp Cloud API Credentials (Server-side only)
# Required when testing real delivery with Meta test credentials (WHATSAPP_PROVIDER=cloud_api).
# To activate real test sending:
# 1. Set WHATSAPP_PROVIDER=cloud_api
# 2. Explicitly set WHATSAPP_LIVE_SENDING_ENABLED=true
# 3. Supply Meta Developer App test credentials below
# Never expose these credentials to client apps or frontends.
# WHATSAPP_API_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=100000000000001
# WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000002
# WHATSAPP_GRAPH_API_VERSION=v20.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=escora_wa_verify_token_here
# WHATSAPP_APP_SECRET=your_meta_app_secret_for_webhook_signature
# WHATSAPP_TEST_PHONE_NUMBER=+919876543210

# WhatsApp Automation Trigger Controls
ENABLE_WHATSAPP_ENQUIRY_ACKNOWLEDGEMENT=true
ENABLE_WHATSAPP_BOOKING_CONFIRMATION=true
ENABLE_WHATSAPP_ITINERARY_UPDATES=true
ENABLE_WHATSAPP_PAYMENT_RECEIPTS=true
ENABLE_WHATSAPP_PAYMENT_REMINDERS=true
ENABLE_WHATSAPP_PRE_TRIP_REMINDERS=true
ENABLE_WHATSAPP_POST_TRIP_FEEDBACK=true
ENABLE_WHATSAPP_DOCUMENT_DELIVERY=true

# Mock Simulation Settings
# Automatically simulates delivered and read status transitions for UI testing
WHATSAPP_SIMULATE_AUTO_DELIVER=true

