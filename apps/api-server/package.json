{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --watch --watch-path=./dist/index.mjs --watch-path=../../.env --env-file-if-exists=../../.env --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "watch": "node ./build.mjs --watch",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@types/express-session": "^1.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "groq-sdk": "^1.6.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^10.1.7",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
